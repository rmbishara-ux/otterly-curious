   }
  ]
 },
 {
  "shot": "E04-S013",
  "still": "E04-S013",
  "img_job": "6242bba1-dee2-4492-a8c6-b13c2292463c",
  "dur": 11.18,
  "gen": 12,
  "camera": "close",
  "chars": [
