    "length": 5.76
   }
  ]
 },
 {
  "shot": "E04-S018",
  "still": "E04-S018",
  "img_job": "91fbc655-1ffc-446a-a6f5-5634d8bd7936",
  "dur": 5.0,
  "gen": 5,
  "camera": "close",
  "chars": [
   "pip"
  ],
  "lines": [
   {
    "char": "pip",
    "text": "Oh no. It's tilting...",
