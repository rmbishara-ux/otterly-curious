  ]
 },
 {
  "shot": "E04-S016",
  "still": "E04-S016",
  "img_job": "64a69309-2f60-4448-9027-33c03b58aeef",
  "dur": 7.26,
  "gen": 8,
  "camera": "close",
  "chars": [
   "ollie",
   "pip"
  ],
  "lines": [
