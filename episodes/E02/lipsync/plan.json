   "pip"
  ],
  "lines": [
   {
    "char": "pip",
    "text": "Ollie, look! They are all linked up.",
    "start": 0.5,
    "length": 3.66
   },
   {
    "char": "ollie",
    "text": "They're holding hands, even while they sleep!",
    "start": 4.56,
    "length": 5.39
   }
  ]
 },
 {
  "shot": "E02-S003",
  "still": "E02-S003",
  "img_job": "31494935-45ca-4974-b420-ad31f6b1d3b6",
  "dur": 5.0,
  "gen": 5,
  "camera": "close",
  "chars": [
   "ollie"
  ],
  "lines": [
   {
    "char": "ollie",
    "text": "Why do otters hold hands?",
    "start": 0.5,
    "length": 2.36
   }
  ]
 },
 {
  "shot": "E02-S004",
  "still": "E02-S004",
  "img_job": "a931ad72-32f3-49ea-9d6d-d27b9210cbd7",
  "dur": 4.12,
  "gen": 5,
  "camera": "static",
  "chars": [
