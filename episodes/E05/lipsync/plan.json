    "text": "Try it at home! Ask a grown-up to help you.",
    "start": 0.5,
    "length": 3.95
   },
   {
    "char": "ollie",
    "text": "Wet a paper towel and fold it. Put it in a clear bag with a bean.",
    "start": 4.85,
    "length": 4.32
   }
