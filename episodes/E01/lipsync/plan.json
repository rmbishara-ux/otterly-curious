   }
  ]
 },
 {
  "shot": "E01-S029",
  "still": "E01-S029",
  "dur": 4.0,
  "gen": 4,
  "camera": "wide",
  "chars": [
   "gus"
  ],
  "lines": [
   {
    "char": "gus",
    "text": "Whoa, whoa, whoaaa!",
