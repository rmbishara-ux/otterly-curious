  "camera": "slow_push",
  "chars": [
   "ollie",
   "bean",
   "luna",
   "gus",
   "pip"
  ],
  "lines": [
   {
    "char": "gus",
    "text": "Not this time! We bring the sea back ourselves!",
    "start": 0.5,
    "length": 4.84
   }
  ]
 },
 {
  "shot": "E01-S023",
  "still": "E01-S022",
